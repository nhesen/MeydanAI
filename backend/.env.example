# development | test | production
# Production rejects wildcard CORS and AUTH_RATE_LIMIT_ENABLED=false.
APP_ENV=development
APP_NAME=MeydanAI API
API_V1_PREFIX=/api/v1

# Required PostgreSQL SQLAlchemy URL. No SQLite fallback.
DATABASE_URL=postgresql+psycopg://meydanai:change-me-for-local-development@localhost:5432/meydanai

# Comma-separated trusted browser origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

ANALYTICS_PROVIDER=external
MAX_VIDEO_UPLOAD_SIZE=524288000
VIDEO_STORAGE_PATH=./var/videos
RAW_VIDEO_RETENTION_DAYS=30
MAX_POSITION_SAMPLES_PER_INGESTION=10000

# Required only for internal worker ingestion endpoints. Leave empty to disable them.
INTERNAL_WORKER_TOKEN=

# Opaque session lifetime in hours.
AUTH_SESSION_TTL_HOURS=168

# If set and no admin exists yet, this email becomes admin on first registration.
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# Keep true in production.
AUTH_RATE_LIMIT_ENABLED=true
